{
  "name": "pelican-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "dev": "wrangler dev --test-scheduled",
    "backfill:local": "tsx scripts/backfill.ts .wrangler/backfill.sql && wrangler d1 execute pelican-api --local --file .wrangler/backfill.sql",
    "backfill:remote": "tsx scripts/backfill.ts .wrangler/backfill.sql && wrangler d1 execute pelican-api --remote --file .wrangler/backfill.sql",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
