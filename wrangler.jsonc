{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pelican-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "vars": {
    "CONTACT_EMAIL": "dynamicalchange@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pelican-api",
      "database_id": "fcd0cd0f-edcc-4113-8db0-94c9458474a1",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 6 * * *"]
  }
}
